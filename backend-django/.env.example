# Copiar a .env y completar. NO subir .env al repositorio.

DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# Base de datos PostgreSQL compartida (misma que usa Spring Boot / docker-compose)
DB_NAME=plantia
DB_USER=plantia
DB_PASSWORD=plantia
DB_HOST=localhost
DB_PORT=5432

# Motor de IA: openai | webui | gemini | local | mock | auto
IA_PROVIDER=auto

# Nube
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# IA institucional local (Open WebUI / vLLM, API compatible con OpenAI).
# El modelo debe ser multimodal para reconocer plantas.
WEBUI_BASE_URL=http://192.168.17.11:3000/api/v1
WEBUI_API_KEY=
WEBUI_MODEL=Qwen/Qwen3.6-35B-A3B-FP8

# Modelo local (Ollama / servidor compatible)
LOCAL_IA_URL=http://localhost:11434
LOCAL_IA_MODEL=llava

# CORS (para que React pueda llamar directo en desarrollo)
CORS_ALLOW_ALL=true
