# Copiar a .env y completar. NO subir .env al repositorio.

DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# Base de datos PostgreSQL compartida (misma que usa Spring Boot / docker-compose)
DB_NAME=plantia
DB_USER=plantia
DB_PASSWORD=plantia
DB_HOST=localhost
DB_PORT=5432

# Motor de IA: openai | gemini | local | mock | auto
IA_PROVIDER=auto

# Nube
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Modelo local (Ollama / servidor compatible)
LOCAL_IA_URL=http://localhost:11434
LOCAL_IA_MODEL=llava

# CORS (para que React pueda llamar directo en desarrollo)
CORS_ALLOW_ALL=true
